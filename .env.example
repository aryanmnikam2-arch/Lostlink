# ─── Flask ────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_DEBUG=True

# ─── Dev mode (set to true to skip login/OTP entirely) ─
DEV_BYPASS_LOGIN=false
DEV_USER_EMAIL=devtest@vitbhopal.ac.in

# ─── Allowed email domain ─────────────────────────────
ALLOWED_DOMAIN=vitbhopal.ac.in

# ─── Google Gemini API ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── SMTP (Gmail recommended) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Upload settings ──────────────────────────────────
MAX_UPLOAD_MB=5
